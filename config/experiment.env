#!/usr/bin/env bash

_config_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="${REPO_ROOT:-$(cd -- "${_config_dir}/.." && pwd)}"
unset _config_dir

# Audited nnU-Net source revision.
export NNUNET_REPOSITORY="${NNUNET_REPOSITORY:-https://github.com/MIC-DKFZ/nnUNet.git}"
export NNUNET_COMMIT="${NNUNET_COMMIT:-f6d221d1b79cd2173650f78f97ecfee273e0cf86}"
export THIRD_PARTY_DIR="${THIRD_PARTY_DIR:-${REPO_ROOT}/third_party}"
export NNUNET_SOURCE_DIR="${NNUNET_SOURCE_DIR:-${THIRD_PARTY_DIR}/nnUNet}"
export NNUNET_OVERLAY_DIR="${NNUNET_OVERLAY_DIR:-${REPO_ROOT}/src/nnunet_overlays}"

# Audited runtime. Use a fresh environment rather than an existing production env.
export EXPECTED_PYTHON_VERSION="${EXPECTED_PYTHON_VERSION:-3.11.15}"
export EXPECTED_TORCH_VERSION="${EXPECTED_TORCH_VERSION:-2.11.0+cu130}"
export EXPECTED_TORCH_CUDA="${EXPECTED_TORCH_CUDA:-13.0}"
export PYTHON_BOOTSTRAP_BIN="${PYTHON_BOOTSTRAP_BIN:-python3.11}"
export VENV_DIR="${VENV_DIR:-${REPO_ROOT}/.venv}"
export PYTHON_BIN="${PYTHON_BIN:-${VENV_DIR}/bin/python}"
export PIP_BIN="${PIP_BIN:-${VENV_DIR}/bin/pip}"

# Private nnU-Net data roots. Override these in the shell; never commit host paths.
export NNUNET_DATA_ROOT="${NNUNET_DATA_ROOT:-${REPO_ROOT}/.local/nnUNet_data}"
export nnUNet_raw="${nnUNet_raw:-${NNUNET_DATA_ROOT}/nnUNet_raw}"
export nnUNet_preprocessed="${nnUNet_preprocessed:-${NNUNET_DATA_ROOT}/nnUNet_preprocessed}"
export nnUNet_results="${nnUNet_results:-${REPO_ROOT}/runs/nnUNet_results_K4}"
export nnUNet_compile="${nnUNet_compile:-false}"

export DATASET_ID="${DATASET_ID:-7}"
export DATASET_NAME="${DATASET_NAME:-Dataset007_Brats26_Goat_MLConsensusPseudo}"
export CONFIGURATION="${CONFIGURATION:-3d_fullres}"
export PLANS="${PLANS:-nnUNetResEncUNetMPlans_D005Compat}"
export TRAINER="${TRAINER:-nnUNetTrainer_D007ETTCRegionAuxHead_SoftMoEConfigK_Pilot}"
export PREPROCESSED_DATA_IDENTIFIER="${PREPROCESSED_DATA_IDENTIFIER:-nnUNetResEncUNetMPlans_D005Compat_nnUNetPlans_3d_fullres}"

export RAW_DATASET_DIR="${RAW_DATASET_DIR:-${nnUNet_raw}/${DATASET_NAME}}"
export PREPROCESSED_DATASET_DIR="${PREPROCESSED_DATASET_DIR:-${nnUNet_preprocessed}/${DATASET_NAME}}"
export PREPROCESSED_DATA_DIR="${PREPROCESSED_DATA_DIR:-${PREPROCESSED_DATASET_DIR}/${PREPROCESSED_DATA_IDENTIFIER}}"
export RESULT_ROOT="${RESULT_ROOT:-${nnUNet_results}/${DATASET_NAME}/${TRAINER}__${PLANS}__${CONFIGURATION}}"

# Exact-reproduction assets are private and deliberately absent from Git.
export PRIVATE_ASSETS_DIR="${PRIVATE_ASSETS_DIR:-${REPO_ROOT}/private_assets}"
export PRIVATE_MANIFEST="${PRIVATE_MANIFEST:-${PRIVATE_ASSETS_DIR}/dataset007_case_manifest.csv}"
export PRIVATE_SPLITS="${PRIVATE_SPLITS:-${PRIVATE_ASSETS_DIR}/splits_final.json}"
export CASE_WEIGHT_ROOT="${CASE_WEIGHT_ROOT:-${PRIVATE_ASSETS_DIR}/case_weights}"
export CASE_META_FILE="${CASE_META_FILE:-${CASE_WEIGHT_ROOT}/d007_case_region_cluster_meta.csv}"
export D005_PRETRAINED_ROOT="${D005_PRETRAINED_ROOT:-${PRIVATE_ASSETS_DIR}/pretrained_d005_resencm}"
export D005_LABELS_DIR="${D005_LABELS_DIR:-${PRIVATE_ASSETS_DIR}/dataset005_labelsTr}"

# Exact K=4 controls observed in all five fold logs/debug files.
export SOFTMOE_NUM_EXPERTS="${SOFTMOE_NUM_EXPERTS:-4}"
export SOFTMOE_TEMPERATURE="${SOFTMOE_TEMPERATURE:-1.0}"
export SOFTMOE_BALANCE_WEIGHT="${SOFTMOE_BALANCE_WEIGHT:-0.001}"
export SOFTMOE_ADAPTER_SCALE_INIT="${SOFTMOE_ADAPTER_SCALE_INIT:-0.1}"
export SOFTMOE_REDUCTION="${SOFTMOE_REDUCTION:-4}"
export SOFTMOE_MAX_EPOCHS="${SOFTMOE_MAX_EPOCHS:-500}"
export SOFTMOE_NUM_ITERATIONS_PER_EPOCH="${SOFTMOE_NUM_ITERATIONS_PER_EPOCH:-250}"
export SOFTMOE_NUM_VAL_ITERATIONS_PER_EPOCH="${SOFTMOE_NUM_VAL_ITERATIONS_PER_EPOCH:-50}"
export SOFTMOE_PILOT_OUTPUT_DIR="${SOFTMOE_PILOT_OUTPUT_DIR:-${REPO_ROOT}/runs/softmoe_diagnostics}"
export DATASET006_PSEUDO_WEIGHT_MODE="${DATASET006_PSEUDO_WEIGHT_MODE:-ramp}"
export DATASET006_PSEUDO_FIXED_WEIGHT="${DATASET006_PSEUDO_FIXED_WEIGHT:-0.5}"
export D007_ETAWARE_CASE_WEIGHT_ROOT="${D007_ETAWARE_CASE_WEIGHT_ROOT:-${CASE_WEIGHT_ROOT}}"
export D007_ETAWARE_DISABLE_CASE_WEIGHTS="${D007_ETAWARE_DISABLE_CASE_WEIGHTS:-0}"

export FOLDS="${FOLDS:-0 1 2 3 4}"
export GPU_ID="${GPU_ID:-0}"
export DEVICE="${DEVICE:-cuda}"
export CONTINUE_IF_POSSIBLE="${CONTINUE_IF_POSSIBLE:-1}"
export SKIP_COMPLETED="${SKIP_COMPLETED:-1}"
export DRY_RUN="${DRY_RUN:-0}"
export ALLOW_NONEXACT="${ALLOW_NONEXACT:-0}"

# Frozen public/private asset SHA-256 values.
export DATASET_JSON_SHA256="${DATASET_JSON_SHA256:-089ca9b7e4f06eaaad40b7c95ebe64ba713e1265383cf9e44a3921e6664e9ce7}"
export PRIVATE_MANIFEST_SHA256="${PRIVATE_MANIFEST_SHA256:-76feef1b15e1bd8eac31443e84875ab13329b9d77b30fd139f50f8738ca4f665}"
export PRIVATE_SPLITS_SHA256="${PRIVATE_SPLITS_SHA256:-fba61c6486e48a3893b5ce9147271e44e8aacf48718db86f552fbacdfea6957e}"
export PLANS_SHA256="${PLANS_SHA256:-0366b1cc26a4ab09082c2b72fb35774514195c634b552a63044e5dbee6b483d9}"
export CASE_META_SHA256="${CASE_META_SHA256:-852d03abb62c6251e2a414bf106d36df542ebf4ace27cdf2ade5341dad63870c}"
export CASE_WEIGHT_FOLD0_SHA256="${CASE_WEIGHT_FOLD0_SHA256:-d594e55e7073a8b0d347e216d7cdd43dbdd17f0a3de019ef70bc74c63688c249}"
export CASE_WEIGHT_FOLD1_SHA256="${CASE_WEIGHT_FOLD1_SHA256:-cf49e9681dd6b16a494945f6890ef56e3951e35ced7fcfe94d2783ec584ae29f}"
export CASE_WEIGHT_FOLD2_SHA256="${CASE_WEIGHT_FOLD2_SHA256:-2cf4f8e788e24ab965638b2dac4c7d170d8d425b2c84219662cf5d7905594bff}"
export CASE_WEIGHT_FOLD3_SHA256="${CASE_WEIGHT_FOLD3_SHA256:-7e0f574e030df161d62bb4a85d1b8c3d68b0818aa80d842c3ce28c56748fec41}"
export CASE_WEIGHT_FOLD4_SHA256="${CASE_WEIGHT_FOLD4_SHA256:-3d15d6c39a7e300c4bb61a1d766823f2246000e3dcf5c633e67f7909f764eef6}"
export D005_FOLD0_SHA256="${D005_FOLD0_SHA256:-02ef1d4310e61e90a90cbf452ab9ff4a5ce62bd090759da6d1b03dbf1d5f2ad7}"
export D005_FOLD1_SHA256="${D005_FOLD1_SHA256:-42cf485aadad58b7d7b47d5715b2d2a282da53534ad3ff619dfc7dc88e961a39}"
export D005_FOLD2_SHA256="${D005_FOLD2_SHA256:-a2a3992ad3de73684913713c2deff418fab33008b8248074a41e62b91187a1fb}"
export D005_FOLD3_SHA256="${D005_FOLD3_SHA256:-24372da3da6f65c4972b41158c0b954edc49ce45eb76bd608e94410b840ed9fc}"
export D005_FOLD4_SHA256="${D005_FOLD4_SHA256:-d28917c3cbd4220f59a73eb0e48258a4e5c827723e6bff7aac3c4712050f7fe1}"

case ":${PYTHONPATH:-}:" in
  *":${NNUNET_SOURCE_DIR}:"*) ;;
  *) export PYTHONPATH="${NNUNET_SOURCE_DIR}${PYTHONPATH:+:${PYTHONPATH}}" ;;
esac
