#!/usr/bin/env bash

_config_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="${REPO_ROOT:-$(cd -- "${_config_dir}/.." && pwd)}"
unset _config_dir

# Pinned nnU-Net source and runtime used by the public launchers.
export NNUNET_REPOSITORY="${NNUNET_REPOSITORY:-https://github.com/MIC-DKFZ/nnUNet.git}"
export NNUNET_COMMIT="${NNUNET_COMMIT:-f6d221d1b79cd2173650f78f97ecfee273e0cf86}"
export THIRD_PARTY_DIR="${THIRD_PARTY_DIR:-${REPO_ROOT}/third_party}"
export NNUNET_SOURCE_DIR="${NNUNET_SOURCE_DIR:-${THIRD_PARTY_DIR}/nnUNet}"
export NNUNET_OVERLAY_DIR="${NNUNET_OVERLAY_DIR:-${REPO_ROOT}/src/nnunet_overlays}"
export EXPECTED_PYTHON_VERSION="${EXPECTED_PYTHON_VERSION:-3.11.15}"
export EXPECTED_TORCH_VERSION="${EXPECTED_TORCH_VERSION:-2.11.0+cu130}"
export EXPECTED_TORCH_CUDA="${EXPECTED_TORCH_CUDA:-13.0}"
export PYTHON_BOOTSTRAP_BIN="${PYTHON_BOOTSTRAP_BIN:-python3.11}"
export VENV_DIR="${VENV_DIR:-${REPO_ROOT}/.venv}"
export PYTHON_BIN="${PYTHON_BIN:-${VENV_DIR}/bin/python}"
export PIP_BIN="${PIP_BIN:-${VENV_DIR}/bin/pip}"

# Final strict-QC Dataset007 only.
export DATASET_ID="${DATASET_ID:-7}"
export DATASET_NAME="${DATASET_NAME:-Dataset007_Brats26_Goat_MLConsensusPseudo}"
export EXPECTED_PSEUDO_CASES="${EXPECTED_PSEUDO_CASES:-983}"
export EXPECTED_TOTAL_CASES="${EXPECTED_TOTAL_CASES:-2334}"
# Override these roots with authorized BraTS/Synapse assets.
export NNUNET_DATA_ROOT="${NNUNET_DATA_ROOT:-${REPO_ROOT}/.local/nnUNet_data}"
export nnUNet_raw="${nnUNet_raw:-${NNUNET_DATA_ROOT}/nnUNet_raw}"
export nnUNet_preprocessed="${nnUNet_preprocessed:-${NNUNET_DATA_ROOT}/nnUNet_preprocessed}"
export nnUNet_results="${nnUNet_results:-${REPO_ROOT}/runs/nnUNet_results}"
export nnUNet_compile="${nnUNet_compile:-false}"

export CONFIGURATION="${CONFIGURATION:-3d_fullres}"
export PLANS="${PLANS:-nnUNetResEncUNetMPlans_D005Compat}"
export TRAINER="${TRAINER:-nnUNetTrainer_D007ETTCRegionAuxHead_SoftMoEConfigK_Pilot}"
export PREPROCESSED_DATA_IDENTIFIER="${PREPROCESSED_DATA_IDENTIFIER:-nnUNetResEncUNetMPlans_D005Compat_nnUNetPlans_3d_fullres}"
export RAW_DATASET_DIR="${RAW_DATASET_DIR:-${nnUNet_raw}/${DATASET_NAME}}"
export PREPROCESSED_DATASET_DIR="${PREPROCESSED_DATASET_DIR:-${nnUNet_preprocessed}/${DATASET_NAME}}"
export PREPROCESSED_DATA_DIR="${PREPROCESSED_DATA_DIR:-${PREPROCESSED_DATASET_DIR}/${PREPROCESSED_DATA_IDENTIFIER}}"
export RESULT_ROOT="${RESULT_ROOT:-${nnUNet_results}/${DATASET_NAME}/${TRAINER}__${PLANS}__${CONFIGURATION}}"

export PRIVATE_ASSETS_DIR="${PRIVATE_ASSETS_DIR:-${REPO_ROOT}/private_assets}"
export PRIVATE_SPLITS="${PRIVATE_SPLITS:-${PRIVATE_ASSETS_DIR}/splits_final.json}"
export CASE_WEIGHT_ROOT="${CASE_WEIGHT_ROOT:-${PRIVATE_ASSETS_DIR}/case_weights}"
export D005_PRETRAINED_ROOT="${D005_PRETRAINED_ROOT:-${PRIVATE_ASSETS_DIR}/pretrained_d005_resencm}"
export D005_LABELS_DIR="${D005_LABELS_DIR:-${PRIVATE_ASSETS_DIR}/dataset005_labelsTr}"

# Dense K=4 adapter and mixed-supervision settings.
export SOFTMOE_NUM_EXPERTS="${SOFTMOE_NUM_EXPERTS:-4}"
export SOFTMOE_TEMPERATURE="${SOFTMOE_TEMPERATURE:-1.0}"
export SOFTMOE_BALANCE_WEIGHT="${SOFTMOE_BALANCE_WEIGHT:-0.001}"
export SOFTMOE_ADAPTER_SCALE_INIT="${SOFTMOE_ADAPTER_SCALE_INIT:-0.1}"
export SOFTMOE_REDUCTION="${SOFTMOE_REDUCTION:-4}"
export D007_ETAWARE_CASE_WEIGHT_ROOT="${D007_ETAWARE_CASE_WEIGHT_ROOT:-${CASE_WEIGHT_ROOT}}"

export FOLDS="${FOLDS:-0 1 2 3 4}"
export GPU_ID="${GPU_ID:-0}"
export DEVICE="${DEVICE:-cuda}"
export CONTINUE_IF_POSSIBLE="${CONTINUE_IF_POSSIBLE:-1}"
export SKIP_COMPLETED="${SKIP_COMPLETED:-1}"
export DRY_RUN="${DRY_RUN:-0}"

case ":${PYTHONPATH:-}:" in
  *":${NNUNET_SOURCE_DIR}:"*) ;;
  *) export PYTHONPATH="${NNUNET_SOURCE_DIR}${PYTHONPATH:+:${PYTHONPATH}}" ;;
esac
